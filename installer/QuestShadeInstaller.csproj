<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QuestShadeInstaller</AssemblyName>
    <RootNamespace>QuestShadeInstaller</RootNamespace>
    <Version>1.0.0</Version>
    <Product>QuestShade Installer</Product>
    <AssemblyTitle>QuestShade Installer</AssemblyTitle>
    <Description>Installs the QuestShade mod on BONELAB for Meta Quest</Description>
    <Company>MonkeOnYT</Company>
    <Copyright>MonkeOnYT, GPL-3.0</Copyright>
    <Nullable>disable</Nullable>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="logo.png" LogicalName="QuestShadeInstaller.logo.png" />
    <EmbeddedResource Include="fonts\*.ttf" LogicalName="QuestShadeInstaller.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="bg\*.jpg" LogicalName="QuestShadeInstaller.bg.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
