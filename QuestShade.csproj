<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <QSTarget Condition="'$(QSTarget)' == ''">Quest</QSTarget>
    <TargetFramework>net8.0</TargetFramework>
    <OutputPath>bin\$(QSTarget)\</OutputPath>
    <DefineConstants>$(DefineConstants);QUEST</DefineConstants>
    <DefineConstants Condition="'$(QSStore)' == 'true'">$(DefineConstants);THUNDERSTORE</DefineConstants>
    <OutputPath Condition="'$(QSStore)' == 'true'">bin/$(QSTarget)-Store/</OutputPath>
    <AssemblyName>QuestShade</AssemblyName>
    <Version>1.7.8</Version>
    <RootNamespace>QuestShade</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0618;CS8632</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONELAB</GameDir>
    <ML>C:\QSBuild\quest\ml</ML>
    <IA>C:\QSBuild\quest\ia</IA>
    <Bundles>C:\QSBuild\bundles</Bundles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="unity\**;bin\**;obj\**;trailer\**;updater\**;installer\**;server\**;discord\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(ML)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(ML)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(ML)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(IA)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(IA)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(IA)\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VRModule"><HintPath>$(IA)\UnityEngine.VRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(IA)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(IA)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(IA)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(IA)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(IA)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(IA)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(IA)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(IA)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(IA)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Il2CppAssetBundleManager"><HintPath>$(ML)\UnityEngine.Il2CppAssetBundleManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JNISharp"><HintPath>$(ML)\JNISharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.StressLevelZero.VRS"><HintPath>$(IA)\Unity.RenderPipelines.Universal.StressLevelZero.VRS.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSLZ.Marrow"><HintPath>$(IA)\Il2CppSLZ.Marrow.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(IA)\Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(IA)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(IA)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AndroidJNIModule"><HintPath>$(IA)\UnityEngine.AndroidJNIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BoneLib"><HintPath>$(GameDir)\Mods\BoneLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(IA)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(IA)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(Bundles)\android\questshade" LogicalName="QuestShade.Bundles.android" Condition="Exists('$(Bundles)\android\questshade')" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Defaults\**\*" LogicalName="QuestShade.Defaults.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Ports\*.ini" LogicalName="QuestShade.Ports.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
